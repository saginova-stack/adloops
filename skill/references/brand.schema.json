{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saginova/adloops/brand.schema.json",
  "title": "AdLoops Brand Configuration",
  "type": "object",
  "required": ["company", "icp", "valueProps", "brandVoice", "guardrails"],
  "additionalProperties": false,
  "properties": {
    "company": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "linkedinPage": { "type": "string", "format": "uri" }
      }
    },
    "icp": {
      "type": "object",
      "required": ["personas"],
      "additionalProperties": false,
      "properties": {
        "personas": { "type": "array", "items": { "type": "string" } },
        "industries": { "type": "array", "items": { "type": "string" } },
        "companySizes": { "type": "array", "items": { "type": "string" } },
        "geo": { "type": "array", "items": { "type": "string" } },
        "painPoints": { "type": "array", "items": { "type": "string" } },
        "negativeSignals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "valueProps": { "type": "array", "items": { "type": "string" } },
    "brandVoice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": { "type": "string" },
        "doSay": { "type": "array", "items": { "type": "string" } },
        "dontSay": { "type": "array", "items": { "type": "string" } }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "accent": { "type": "string" }
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["maxDailyBudgetChangePct", "platforms"],
      "additionalProperties": false,
      "properties": {
        "maxDailyBudgetChangePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "newCampaignRequiresApproval": { "type": "boolean" },
        "neverIncreaseBudgetAbove": { "type": ["number", "null"], "minimum": 0 },
        "platforms": {
          "type": "object",
          "required": ["google", "meta", "linkedin"],
          "additionalProperties": false,
          "properties": {
            "google": { "type": "boolean" },
            "meta": { "type": "boolean" },
            "linkedin": { "type": "boolean" }
          }
        },
        "proposer": {
          "description": "Per-brand tuning for the mutation proposer. Every field is optional; missing fields fall back to the proposer defaults (50, 50, -25, 10).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pauseZombieMinSpend": {
              "description": "Pause any campaign that spent at least this much over the 7-day window with zero conversions.",
              "type": "number",
              "minimum": 0
            },
            "decreaseCpaSpikePct": {
              "description": "Week-over-week CPA growth (percent) that triggers a budget-decrease proposal at the brand's maxDailyBudgetChangePct cap.",
              "type": "number",
              "minimum": 0
            },
            "increaseCpaDropPct": {
              "description": "Week-over-week CPA drop (a non-positive percent, e.g. -25) that triggers a budget-increase proposal when conversions also rose.",
              "type": "number",
              "maximum": 0
            },
            "maxProposalsPerRun": {
              "description": "Hard cap on proposals emitted per run. Pauses are prioritised; once the cap is hit no further proposals are evaluated.",
              "type": "integer",
              "minimum": 1
            },
            "desiredCampaigns": {
              "description": "Campaigns that should exist. Each audit creates any listed campaign not already in the account, always PAUSED, through the guardrails. Only Meta is supported today. Leave absent to disable create_campaign proposals.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["platform", "name", "objective"],
                "additionalProperties": false,
                "properties": {
                  "platform": { "const": "meta" },
                  "name": { "type": "string", "minLength": 1 },
                  "objective": {
                    "description": "Meta ODAX campaign objective.",
                    "type": "string",
                    "enum": [
                      "OUTCOME_AWARENESS",
                      "OUTCOME_TRAFFIC",
                      "OUTCOME_ENGAGEMENT",
                      "OUTCOME_LEADS",
                      "OUTCOME_APP_PROMOTION",
                      "OUTCOME_SALES"
                    ]
                  },
                  "dailyBudget": {
                    "description": "Optional campaign-level daily budget in account-currency major units (Campaign Budget Optimization). Omit to set budgets on ad sets later. If the campaign already exists, each run steps its live budget toward this value within the per-run cap.",
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "specialAdCategories": {
                    "description": "Meta special ad categories (e.g. EMPLOYMENT, HOUSING, CREDIT, FINANCIAL_PRODUCTS_SERVICES). Defaults to none.",
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "adSet": {
                    "description": "Optional default ad set created under the new campaign so it launches populated rather than empty. Also launches PAUSED. Set exactly one of `targeting` or `targetingFromIcp`.",
                    "type": "object",
                    "required": ["name", "optimizationGoal", "billingEvent"],
                    "additionalProperties": false,
                    "oneOf": [
                      { "required": ["targeting"] },
                      { "required": ["targetingFromIcp"] }
                    ],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "optimizationGoal": {
                        "description": "Meta ad-set optimization goal, e.g. LEAD_GENERATION, OFFSITE_CONVERSIONS, LINK_CLICKS, REACH.",
                        "type": "string",
                        "minLength": 1
                      },
                      "billingEvent": {
                        "description": "Meta billing event, e.g. IMPRESSIONS, LINK_CLICKS.",
                        "type": "string",
                        "minLength": 1
                      },
                      "targeting": {
                        "description": "Explicit Meta targeting spec, e.g. {\"geo_locations\": {\"countries\": [\"US\"]}}. Mutually exclusive with targetingFromIcp.",
                        "type": "object",
                        "minProperties": 1
                      },
                      "targetingFromIcp": {
                        "description": "Derive targeting from the brand's ICP at propose time via Meta Targeting Search: icp.geo → geo_locations, icp.personas/industries → interests, icp.negativeSignals → exclusions. Requires at least one icp.geo entry. Mutually exclusive with targeting.",
                        "type": "boolean"
                      },
                      "dailyBudget": {
                        "description": "Ad-set daily budget in account-currency major units (non-CBO campaigns). Omit when the campaign carries a CBO budget.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "bidStrategy": { "type": "string" },
                      "bidAmount": { "type": "number", "exclusiveMinimum": 0 },
                      "promotedObject": {
                        "description": "e.g. {\"pixel_id\": \"...\", \"custom_event_type\": \"LEAD\"} or {\"page_id\": \"...\"}. Required by Meta for some optimization goals.",
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
